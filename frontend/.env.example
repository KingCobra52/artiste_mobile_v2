# These values are safe to expose to browser code. Find them with `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Playwright uses a dedicated account that must already exist.
PLAYWRIGHT_TEST_EMAIL=tester@example.com
PLAYWRIGHT_TEST_PASSWORD=replace-with-a-test-password
