{
  "name": "artiste-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:e2e": "npm run test:e2e:configured && npm run test:e2e:config",
    "test:e2e:configured": "playwright test",
    "test:e2e:config": "playwright test -c playwright.missing-config.config.ts",
    "playwright:install": "playwright install chromium webkit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "^16.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@next/env": "^16.4.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "axe-core": "4.14.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "4.1.12"
  }
}
